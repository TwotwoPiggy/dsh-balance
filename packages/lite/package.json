{
  "name": "dsh-balance-lite",
  "version": "0.2.4",
  "description": "DeepSeek 余额显示插件 (精简版): 纯余额与会话消耗显示，无设置面板",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TwotwoPiggy/dsh-balance.git",
    "directory": "packages/lite"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/smoke-projection.mjs && node test/smoke-client.mjs"
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    }
  }
}
